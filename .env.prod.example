# Public endpoint and staging access gate
# For temporary IP-only HTTP testing, set both values to http://SERVER_IP.
NUTRI_SITE_ADDRESS=nutri.example.com
NUTRI_CORS_ALLOWED_ORIGINS=https://nutri.example.com
ACME_EMAIL=admin@example.com
NUTRI_BASIC_AUTH_USER=nutri-tester
# Generate with:
# docker run --rm caddy:2-alpine caddy hash-password --plaintext 'YOUR_PASSWORD'
# Keep the bcrypt value single-quoted because it contains dollar signs.
NUTRI_BASIC_AUTH_HASH=

# Database
MYSQL_DATABASE=nutri_db
MYSQL_USER=nutri_user
MYSQL_PASSWORD=replace_with_random_hex
MYSQL_ROOT_PASSWORD=replace_with_another_random_hex

# Redis
NUTRI_REDIS_PASSWORD=replace_with_random_hex

# RabbitMQ (use URL-safe characters because the Agent consumes this in an AMQP URL)
NUTRI_RABBITMQ_USERNAME=nutri_mq
NUTRI_RABBITMQ_PASSWORD=replace_with_random_hex

# MinIO
MINIO_ROOT_USER=nutri_oss
MINIO_ROOT_PASSWORD=replace_with_random_hex
NUTRI_OSS_BUCKET=nutri-bucket

# Agent LLM. Leave the key empty to use the rule-based fallback.
NUTRI_LLM_PROVIDER=moonshot
NUTRI_LLM_API_KEY=
NUTRI_LLM_BASE_URL=https://api.moonshot.cn/v1
NUTRI_LLM_MODEL=kimi-k2.6
NUTRI_LLM_TEMPERATURE=1
NUTRI_LLM_TIMEOUT_SECONDS=180

# Protected staging may expose the generated OTP to the client.
# Set false only after a real SMS provider is connected.
NUTRI_AUTH_EXPOSE_DEBUG_CODE=true

# Segmentation runtime
NUTRI_SEG_CHECKPOINT=/models/stage7s1.pth
NUTRI_SEG_INPUT_SIZE=512
NUTRI_REQUIRE_CHECKPOINT=true

# Container image tags
MYSQL_IMAGE=mysql:8.0
REDIS_IMAGE=redis:7-alpine
RABBITMQ_IMAGE=rabbitmq:3-management-alpine
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest
CHROMA_IMAGE=chromadb/chroma:latest
