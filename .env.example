# ── nutri-business (Java Spring Boot) ────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/nutri_db?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=nutri_user
SPRING_DATASOURCE_PASSWORD=nutri_pass

SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=nutri_mq
SPRING_RABBITMQ_PASSWORD=nutri_mq_pass

SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=nutri_redis_pass

OSS_ENDPOINT=http://localhost:9000
OSS_ACCESS_KEY=nutri_oss
OSS_SECRET_KEY=nutri_oss_pass
OSS_BUCKET_NAME=nutri-bucket
OSS_REGION=us-east-1

# ── nutri-ai-mcp (Python FastAPI) ─────────────────────────────────────────────
# No mandatory env vars for development (defaults in pydantic-settings)

# ── nutri-agent (Python LangGraph) ───────────────────────────────────────────
NUTRI_RABBITMQ_URL=amqp://nutri_mq:nutri_mq_pass@localhost:5672/
NUTRI_MCP_SERVER_URL=http://localhost:8000/mcp
NUTRI_CHROMA_HOST=localhost
NUTRI_CHROMA_PORT=8100
NUTRI_OPENAI_API_KEY=sk-...        # Replace with your OpenAI key
NUTRI_OPENAI_BASE_URL=https://api.openai.com/v1
NUTRI_LLM_MODEL=gpt-4o-mini
