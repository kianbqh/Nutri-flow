{
	email {$ACME_EMAIL}
	admin off
}

{$NUTRI_SITE_ADDRESS} {
	encode zstd gzip

	request_body {
		max_size 15MB
	}

	route {
		@unlock {
			method POST
			path /_access/unlock
			header X-Nutri-Access-Code {$NUTRI_ACCESS_CODE}
		}
		handle @unlock {
			header Set-Cookie "nutri_access={$NUTRI_ACCESS_SESSION}; Path=/; Max-Age=604800; HttpOnly; Secure; SameSite=Strict"
			respond 204
		}

		handle /_access/unlock {
			header Content-Type application/json
			respond `{"error":"INVALID_ACCESS_CODE"}` 401
		}

		handle /_access/logout {
			header Set-Cookie "nutri_access=; Path=/; Max-Age=0; HttpOnly; Secure; SameSite=Strict"
			redir / 303
		}

		@apiWithCode {
			path /api/*
			header X-Nutri-Access-Code {$NUTRI_ACCESS_CODE}
		}
		handle @apiWithCode {
			reverse_proxy business:8080 {
				transport http {
					response_header_timeout 360s
				}
			}
		}

		@session header_regexp Cookie "nutri_access={$NUTRI_ACCESS_SESSION}"
		@apiWithSession {
			path /api/*
			header_regexp Cookie "nutri_access={$NUTRI_ACCESS_SESSION}"
		}
		handle @apiWithSession {
			reverse_proxy business:8080 {
				transport http {
					response_header_timeout 360s
				}
			}
		}

		@api path /api/*
		handle @api {
			header Content-Type application/json
			respond `{"error":"ACCESS_CODE_REQUIRED"}` 401
		}

		handle @session {
			root * /srv
			try_files {path} /index.html
			file_server
		}

		handle {
			root * /access
			try_files {path} /index.html
			file_server
		}
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	header {
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
	}

	log {
		output stdout
		format console
	}
}
