NUTRI_LLM_PROVIDER=moonshot

# Shared LLM overrides (optional)
NUTRI_LLM_API_KEY=
NUTRI_LLM_BASE_URL=
NUTRI_LLM_MODEL=
NUTRI_LLM_TEMPERATURE=0.3
NUTRI_LLM_TIMEOUT_SECONDS=40
NUTRI_ADVICE_MIN_CONFIDENCE=0.65

# Provider-specific presets
NUTRI_DEEPSEEK_API_KEY=
NUTRI_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
NUTRI_DEEPSEEK_MODEL=deepseek-chat

NUTRI_MOONSHOT_API_KEY=
NUTRI_MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
NUTRI_MOONSHOT_MODEL=moonshot-v1-8k

NUTRI_OPENAI_API_KEY=
NUTRI_OPENAI_BASE_URL=https://api.openai.com/v1
NUTRI_OPENAI_MODEL=gpt-4o-mini

# Agent integrations
NUTRI_BUSINESS_BASE_URL=http://127.0.0.1:18080/api/v1
NUTRI_AGENT_TASK_TIMEOUT_SEC=300
NUTRI_CHROMA_HOST=127.0.0.1
NUTRI_CHROMA_PORT=8100
NUTRI_CHROMA_ENABLED=true
NUTRI_CHROMA_NUTRITION_COLLECTION=nutrition_knowledge
NUTRI_CHROMA_USER_MEMORY_COLLECTION=user_memory
NUTRI_CHROMA_NUTRITION_RESULTS=5
NUTRI_CHROMA_USER_MEMORY_RESULTS=4
NUTRI_CHROMA_NUTRITION_BOOTSTRAP_ON_STARTUP=true
NUTRI_CHROMA_MEMORY_BOOTSTRAP_FROM_HISTORY=true
NUTRI_CHROMA_MEMORY_MAX_BOOTSTRAP_RECORDS=20
NUTRI_LOCAL_KB_PATH=app/nodes/nutrition_kb.json
